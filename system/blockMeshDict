FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

vertices
(
    (-0.48 -0.36 -0.01)     // 0: inlet inferior izquierdo
    (1.08 -0.36 -0.01)      // 1: outlet inferior derecho
    (1.08 0.36 -0.01)       // 2: outlet superior derecho
    (-0.48 0.36 -0.01)      // 3: inlet superior izquierdo
    (-0.48 -0.36 0.01) // 4: front inferior izquierdo
    (1.08 -0.36 0.01)  // 5: front inferior derecho
    (1.08 0.36 0.01)   // 6: front superior derecho
    (-0.48 0.36 0.01)  // 7: front superior izquierdo
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (78 36 1) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ( (0 4 7 3) );
    }
    outlet
    {
        type patch;
        faces ( (1 2 6 5) );
    }
    bottomWall
    {
        type wall;
        faces ( (0 1 5 4) );
    }
    topWall
    {
        type wall;
        faces ( (3 7 6 2) );
    }
    front
    {
        type patch;
        faces ( (0 3 2 1) );
    }

    back
    {
        type patch;
        faces ( (4 5 6 7) );
    }
);

