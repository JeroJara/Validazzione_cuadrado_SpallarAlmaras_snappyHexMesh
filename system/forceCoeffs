FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      forceCoeffs;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            forceCoeffs;
libs            ("libforces.so");
writeControl    timeStep;
writeInterval   1;
patches         ("cubo");
rho             rhoInf;
rhoInf          1.2;
magUInf         25;
CofR            (0 0 0);
liftDir         (0 1 0);
dragDir         (1 0 0);
pitchAxis       (0 0 1);
Aref            0.0;
lRef            0.06;
log             yes;

