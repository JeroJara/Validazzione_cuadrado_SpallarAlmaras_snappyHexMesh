FoamFile
{ //SOlo para spallart almaras. Viscosidad turbulenta modificada 
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 4.5e-5; // Pon el valor de nuTilda de tu flujo libre
    }
    outlet
    {
        type            zeroGradient;
    }

    // CAMBIA ESTO: En lugar de funciones de pared, usa zeroGradient o slip
    bottomWall
    {
        type            zeroGradient; 
    }
    topWall
    {
        type            zeroGradient;
    }

    // El cubo requiere su propia condición fija en la superficie sólida
    cubo
    {
        type            nutkWallFunction;
        value           uniform 0; // El solucionador modificará este valor dinámicamente
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}


