FoamFile
{ //SOlo para spallart almaras. Viscosidad turbulenta modificada 
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1e-5;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type             fixedValue;
        value            uniform 0;
    }
    topWall
    {
        type             fixedValue;
        value            uniform 0;
    }
    front
    {
        type            zeroGradient;
    }
    back
    {
        type            zeroGradient;
    }
    cubo
    {
        type             fixedValue;
        value            uniform 0;
    }
}

