FoamFile  //Tasa de disipación de energía cinética (qué tan rápidos e disipanlos vórtices)
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.032;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.032;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type            epsilonWallFunction;
        value           uniform 0.032;
    }
    topWall
    {
        type            epsilonWallFunction;
        value           uniform 0.032;
    }
    front
    {
        type            zeroGradient;
    }
    back
    {
        type            zeroGradient;
    }
    cubo
    {
        type            epsilonWallFunction;
        value           uniform 0.032;
    }
}

