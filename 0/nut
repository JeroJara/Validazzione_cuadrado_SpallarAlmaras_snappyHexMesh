FoamFile // Viscosidad turbulenta (Para el modelo matemático)
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    
    // CAMBIA ESTO: Quita la función de pared y pon 'calculated' o 'slip'
    bottomWall
    {
        type            calculated; 
        value           uniform 0;
    }
    topWall
    {
        type            calculated;
        value           uniform 0;
    }

    // Tu cubo es el único sólido real con fricción
    cubo 
    {
        type            nutkWallFunction; // O la función de pared que uses para Spalart-Allmaras
        value           uniform 0;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}


