FoamFile // Energía turbulenta cinética m2/s2
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.375;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.375;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottomWall
    {
        type            kqRWallFunction;
        value           uniform 0.375;
    }
    topWall
    {
        type            kqRWallFunction;
        value           uniform 0.375;
    }
    front
    {
        type            zeroGradient;
    }
    back
    {
        type            zeroGradient;
    }
    cubo
    {
        type            kqRWallFunction;
        value           uniform 0.375;
    }
}

